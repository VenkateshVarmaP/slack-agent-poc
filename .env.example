# Slack Configuration
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Optional comma-separated Slack User IDs allowed to run write tools (empty = allow all)
SLACK_ADMIN_USER_IDS=
SLACK_REQUIRE_APPROVAL_FOR_WRITES=true

# OpenRouter / LLM Configuration
OPENROUTER_API_KEY=sk-or-...
# Active free models supporting tools on OpenRouter:
# - nvidia/nemotron-3.5-super-vl:free
# - nvidia/nemotron-3.5-lightning:free
# - openrouter/free (auto-router)
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODEL=openrouter/free
EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
EMBEDDING_DIMENSIONS=1024

# PostgreSQL + pgvector RAG Configuration (AWS RDS / Aurora / Neon / Supabase)
# Format: postgresql://username:password@your-rds-endpoint.rds.amazonaws.com:5432/postgres
DATABASE_URL=
RAG_ENABLED=true
DB_SSL_REJECT_UNAUTHORIZED=false

# Salesforce Headless 360 MCP Configuration
SF_MCP_ENABLED=true
SF_MCP_SERVER_URL=https://api.salesforce.com/platform/mcp/v1/d/orgfarm-80570c66ae-dev-ed/develop/platform/headless-360
SF_MCP_CLIENT_ID=3MVG97Tt9.zIfTDt4jmNe1k8yGlmrJN2q8Wa.rQNOg3_Jk2vi2zSLHQRTwb7V6c.S_pQ4spSaX7wMmHV1Ifol
SF_MCP_CALLBACK_PORT=8080

# Agent Runtime
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_OUTPUT_CHARS=12000
AGENT_MAX_THREAD_MESSAGES=10
DEBUG=false
